# ── Server ──────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────
# Local:  postgresql://postgres:password@localhost:5432/pikaboo
# Render: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/pikaboo

# ── Redis ────────────────────────────────
# Local:  redis://localhost:6379
# Upstash: rediss://default:token@host:port
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── AWS S3 (media uploads) ───────────────
# Leave blank to use local disk storage during development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=pikaboo-media

# ── App ──────────────────────────────────
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
